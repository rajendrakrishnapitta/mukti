# Free tier (Groq is preferred when both are set — Google free quota is small)
GROQ_API_KEY=                   # https://console.groq.com/keys  ← recommended
GOOGLE_GENERATIVE_AI_API_KEY=   # https://aistudio.google.com/apikey

# Optional: force provider: google | groq | openai
# AI_PROVIDER=google

# Paid fallback
OPENAI_API_KEY=

# Optional: live web grounding (https://tavily.com)
TAVILY_API_KEY=
